# SkillCTI — Backend Environment Variables
# Copy this file to .env and fill in your API keys.
# Only ANTHROPIC_API_KEY is required. All others unlock additional enrichment sources.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── IOC Enrichment (IOC Search page) ─────────────────────────────────────────
# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# urlscan.io — https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api/v1/user/me
OTX_API_KEY=

# ThreatFox (abuse.ch) — https://threatfox.abuse.ch/api/
THREATFOX_API_KEY=

# Intelligence X — https://intelx.io/
# Required for dark web search on the Identity Exposure page.
# Free account available; paid plans for higher quotas.
INTELX_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# proxycheck.io — https://proxycheck.io/dashboard/
# Required for VPN/proxy/Tor detection on the IOC Lookup page.
# VPN detection is only reliable with a key; the unauthenticated API returns inaccurate results.
# Free account available at proxycheck.io (1,000 queries/day).
PROXYCHECK_API_KEY=

# ipinfo.io — https://ipinfo.io/account/token
# Used for geolocation and ISP/ASN data on the Domain Enumeration page.
# Without a token, the free anonymous tier (50K req/month) is used automatically.
# A token raises the limit and improves rate-limit headroom.
IPINFO_API_TOKEN=

# Default TLP label applied to generated reports (TLP:WHITE / TLP:GREEN / TLP:AMBER / TLP:RED)
DEFAULT_TLP=TLP:AMBER

# Your region for the dashboard Regional Threat Pulse (weekly snapshot of threat actors,
# incidents, and CVEs relevant to this geography). Examples: Australia, APAC, United Kingdom
GEOGRAPHY=
