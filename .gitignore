# ── Environment / Secrets ──────────────────────────────────────────────────────
backend/.env
.env
*.env

# ── Generated reports (keep the directory, ignore all content) ────────────────
reports/*.html
reports/*.pdf
reports/*.pptx
reports/*.json
reports/*.meta.json
!reports/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Backend cache ─────────────────────────────────────────────────────────────
backend/cache/
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ── Backend runtime user data (generated at runtime — not seed data) ──────────
backend/data/alerts.json
backend/data/watchlist.json
backend/data/jobs/
backend/logs/

# ── Claude Code settings (local IDE config, not repo config) ──────────────────
.claude/settings.local.json

# ── Node / Frontend ───────────────────────────────────────────────────────────
app/node_modules/
node_modules/
app/dist/
app/.vite/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Local / private customisations (e.g. custom themes, local overrides) ──────
consulting-theme-local/
*.local.*
